#!/bin/sh
# Enforces the AGENTS.md 600-line file-growth ratchet on staged changes.
# Installed via scripts/setup-git-hooks.sh (core.hooksPath).
set -eu

repository_root=$(git rev-parse --show-toplevel)
python3 "$repository_root/scripts/ci/check_file_growth.py" \
  --repository "$repository_root" --base HEAD --head INDEX
