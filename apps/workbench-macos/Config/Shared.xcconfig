// Shared.xcconfig
// Minimal shared configuration for scaffold tool customization
// All other settings use Xcode project defaults
// Generated by XcodeBuildMCP

// ==========================================
// Project Identity
// ==========================================
PRODUCT_NAME = RuntimeWorkbench
PRODUCT_DISPLAY_NAME = Runtime Workbench
PRODUCT_BUNDLE_IDENTIFIER = io.f7z.nmp.runtime-workbench
MARKETING_VERSION = 1.0
CURRENT_PROJECT_VERSION = 1

// ==========================================
// Platform Configuration
// ==========================================
MACOSX_DEPLOYMENT_TARGET = 14.0
ALWAYS_SEARCH_USER_PATHS = NO

// ==========================================
// Info PLIST
// ==========================================
GENERATE_INFOPLIST_FILE = NO
INFOPLIST_FILE = Config/Info.plist

// ==========================================
// Entitlements
// ==========================================
// AI agents can modify Config/RuntimeWorkbench.entitlements to add capabilities
CODE_SIGN_ENTITLEMENTS = Config/RuntimeWorkbench.entitlements

// ==========================================
// Code Signing
// ==========================================
// A stable Team ID is required so Keychain-backed account persistence
// (MacOSKeychainAccountVault) survives across rebuilds: without a team,
// Xcode falls back to ad-hoc signing, which mints a new signing identity
// per build and invalidates access to Keychain items the previous build
// wrote. CI overrides these via command-line flags to stay unsigned.
CODE_SIGN_STYLE = Automatic
DEVELOPMENT_TEAM = 456SHKPP26
