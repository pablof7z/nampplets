// Shared.xcconfig
// Minimal shared configuration for scaffold tool customization
// All other settings use Xcode project defaults
// Generated by XcodeBuildMCP

// ==========================================
// Project Identity
// ==========================================
PRODUCT_NAME = RuntimeWorkbenchiOS
PRODUCT_DISPLAY_NAME = RuntimeWorkbench
PRODUCT_BUNDLE_IDENTIFIER = io.f7z.nmp.runtime-workbench-ios
MARKETING_VERSION = 1.0
CURRENT_PROJECT_VERSION = 1

// ==========================================
// Platform Configuration
// ==========================================
IPHONEOS_DEPLOYMENT_TARGET = 17.0

// (1 == iPhone, 2 == iPad)
TARGETED_DEVICE_FAMILY = 1,2 

// ==========================================
// Info PLIST
// ==========================================
GENERATE_INFOPLIST_FILE = NO
INFOPLIST_FILE = Config/Info.plist

// ==========================================
// Entitlements
// ==========================================
// AI agents can modify Config/RuntimeWorkbenchiOS.entitlements to add capabilities
CODE_SIGN_ENTITLEMENTS = Config/RuntimeWorkbenchiOS.entitlements

// ==========================================
// Code Signing
// ==========================================
// A stable Team ID is required so Keychain-backed account persistence
// (MacOSKeychainAccountVault) survives across rebuilds and on-device runs.
// CI builds for the simulator with CODE_SIGNING_ALLOWED=NO and is
// unaffected by this.
CODE_SIGN_STYLE = Automatic
DEVELOPMENT_TEAM = 456SHKPP26
